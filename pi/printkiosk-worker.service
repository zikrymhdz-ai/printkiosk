[Unit]
Description=PrintKiosk print worker (Brother HL-L3240CDW)
Documentation=file:/home/user/printkiosk/pi/print-worker.py
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/printkiosk

# Everything the worker needs, including PRINT_WORKER_SECRET, lives in this
# file (chmod 600) which install.sh discovers and writes. Do NOT repeat any of
# these as Environment= here: the printer's address in particular changes, and
# having it set in two places is how the worker ended up polling a printer
# address that no longer existed while the CUPS queue used a different one.
EnvironmentFile=/home/user/printkiosk/pi/print-worker.env

ExecStart=/usr/bin/python3 /home/user/printkiosk/pi/print-worker.py

Restart=always
RestartSec=10

# Never print twice because the process was restarted mid-job: give it a
# moment to notice the queue before giving up.
TimeoutStopSec=30
KillSignal=SIGINT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=printkiosk-worker

[Install]
WantedBy=multi-user.target